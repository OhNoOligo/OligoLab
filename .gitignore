# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/

# Lokale Konfiguration mit Maschinenpfaden
.env.local

# Daten, die zur Laufzeit entstehen
data/oligos.db

# Eigene Bausteine und Modifikationen des Nutzers. Die schreibt das Programm,
# und sie gehoeren dem, der sie eintraegt — nicht ins Repository.
data/monomers_custom.yaml
data/modifications_custom.yaml
data/targets/*
!data/targets/.gitkeep
data/structures/*
!data/structures/.gitkeep

# Frontend
node_modules/
frontend/node_modules/

# `frontend/dist/` ist mit ABSICHT nicht ignoriert.
#
# OligoLab geht an Leute, die damit rechnen wollen und nicht entwickeln.
# Wäre die gebaute Oberfläche nicht dabei, bräuchte jeder von ihnen Node.js,
# nur um sie einmal zu bauen — ein Installationsschritt für etwas, das sich
# nie ändert, solange niemand am Quelltext arbeitet.
#
# Preis dafür: wer `frontend/src/` ändert, muss `npm run build` laufen lassen
# und das Ergebnis mit festschreiben, sonst zeigt das Programm den alten
# Stand. Eine veraltete Oberfläche fällt schnell auf; eine fehlende hält
# jeden auf, der das Programm nur benutzen will.

# Editor / OS
.DS_Store
.idea/
.vscode/
