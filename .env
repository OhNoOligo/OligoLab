# OligoLab — lokale Pfade fuer externe Programme.
# Enthaelt bewusst keine Zugangsdaten: OligoLab braucht keine Schluessel.
# Maschinenspezifische Abweichungen gehoeren in .env.local (nicht versioniert).

# MELTING 5 (Java) — erst ab Phase 5 noetig.
MELTING_DIR=

# ORCA — optional, erst ab Phase 6.
ORCA_EXE=

# Arbeitsverzeichnis fuer Zwischendateien.
WORK_DIR=./data/work

# Optionale Sequenzabrufe (Phase 4). Alles freiwillig — ohne Netz bleibt
# OligoLab voll bedienbar.
#
# NCBI bittet darum, bei Abrufen eine Kennmail mitzuschicken, damit sie bei
# Problemen jemanden erreichen koennen. Leer heisst: wird nicht mitgeschickt.
NCBI_EMAIL=
